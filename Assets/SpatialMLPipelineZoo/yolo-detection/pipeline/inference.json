      "attrs": [
        "var candidate_boxes;var candidate_classes;var boxes_for_nms;for(var i=0;i<128;i++){var offset=candidate_classes[i]*1000.0;for(var c=0;c<4;c++)boxes_for_nms[i*4+c]=candidate_boxes[i*4+c]+offset;}"
