          "name": "image_points_mat",
          "tensor": "image_points_mat"
        }
      ],
      "attrs": [
        "// Sample the central area at five points; a hole or another object's edge must not own the depth.\nvar candidate_boxes;var nms_indices;var image_points_mat;\nfunction clip(x){return Math.max(0,Math.min(639,x));}\nvar offsets=[0.5,0.5,0.35,0.35,0.65,0.35,0.35,0.65,0.65,0.65];\nfor(var i=0;i<32;i++){var index=nms_indices[i];var b=index*4;var valid=index>=0&&index<128;\nvar x1=valid?clip(candidate_boxes[b]):0;var y1=valid?clip(candidate_boxes[b+1]):0;\nvar x2=valid?clip(candidate_boxes[b+2]):0;var y2=valid?clip(candidate_boxes[b+3]):0;\nfor(var s=0;s<5;s++){var p=(i*5+s)*2;\nimage_points_mat[p]=x1+(x2-x1)*offsets[s*2];\nimage_points_mat[p+1]=y1+(y2-y1)*offsets[s*2+1];}}"
      ]
    },
