  "operators": [
    {
      "type": "assignment",
      "inputs": [
        "post_det[0:1,0:1]"
      ],
      "outputs": [
        "x1"
      ]
    },
    {
      "type": "assignment",
      "inputs": [
        "post_det[0:1,1:2]"
      ],
      "outputs": [
        "y1"
      ]
    },
    {
      "type": "assignment",
      "inputs": [
        "post_det[0:1,2:3]"
      ],
      "outputs": [
        "x2"
      ]
    },
    {
      "type": "assignment",
      "inputs": [
        "post_det[0:1,3:4]"
      ],
      "outputs": [
        "y2"
      ]
    },
    {
      "type": "assignment",
      "inputs": [
        "post_det[0:1,4:5]"
      ],
      "outputs": [
        "score"
      ]
    },
    {
      "type": "arithmetic",
      "expression": "({0} + {1}) * 0.5",
      "inputs": [
        "x1",
        "x2"
      ],
      "outputs": [
        "center_x"
      ]
    },
    {
      "type": "arithmetic",
      "expression": "({0} + {1}) * 0.5",
      "inputs": [
        "y1",
        "y2"
      ],
      "outputs": [
        "center_y"
      ]
    },
    {
      "type": "assignment",
      "inputs": [
        "center_x"
      ],
      "outputs": [
        "image_point_mat[0:1,0:1]"
      ]
    },
    {
      "type": "assignment",
      "inputs": [
        "center_y"
      ],
      "outputs": [
        "image_point_mat[0:1,1:2]"
      ]
    },
    {
      "type": "assignment",
      "inputs": [
        "image_point_mat"
      ],
      "outputs": [
        "image_point"
      ]
    },
    {
      "type": "uv2_cam",
      "inputs": [
        "image_point",
        "vst_timestamp",
        "vst_camera_matrix",
        "vst_left_image",
        "vst_right_image"
      ],
      "outputs": [
        "point_xyz_array"
      ]
    },
    {
      "type": "assignment",
      "inputs": [
        "point_xyz_array[0]"
      ],
      "outputs": [
        "point_xyz"
      ]
    },
    {
      "type": "elementwise",
      "op": "multiply",
      "inputs": [
        "point_xyz",
        "point_xyz_multiplier"
      ],
      "outputs": [
        "point_xyz"
      ]
    },
    {
      "type": "arithmetic",
      "expression": "({0} - {1})",
      "inputs": [
        "x2",
        "x1"
      ],
      "outputs": [
        "box_width"
      ]
    },
    {
      "type": "arithmetic",
      "expression": "({0} - {1})",
      "inputs": [
        "y2",
        "y1"
      ],
      "outputs": [
        "box_height"
      ]
    },
    {
      "type": "arithmetic",
      "expression": "({0} / 1200.0)",
      "inputs": [
        "box_height"
      ],
      "outputs": [
        "scale_x"
      ]
    },
    {
      "type": "arithmetic",
      "expression": "({0} / 1200.0)",
      "inputs": [
        "box_height"
      ],
      "outputs": [
        "scale_y"
      ]
    },
    {
      "type": "assignment",
      "inputs": [
        "scale_x"
      ],
      "outputs": [
        "frame_scale[0:1,0:1]"
      ]
    },
    {
      "type": "assignment",
      "inputs": [
        "scale_y"
      ],
      "outputs": [
        "frame_scale[1:2,0:1]"
      ]
    },
    {
      "type": "assignment",
      "inputs": [
        "scale_z"
      ],
      "outputs": [
        "frame_scale[2:3,0:1]"
      ]
    },
    {
      "type": "transform",
      "inputs": [
        "rotation",
        "point_xyz",
        "frame_scale"
      ],
      "outputs": [
        "local_pose"
      ]
    },
    {
      "type": "cam_space_to_xr_local",
      "inputs": [
        "vst_timestamp"
      ],
      "outputs": [
        "left_eye_transform"
      ]
    },
    {
      "type": "arithmetic",
      "expression": "({0} * {1})",
      "inputs": [
        "left_eye_transform",
        "local_pose"
      ],
      "outputs": [
        "frame_pose"
      ]
    },
    {
      "type": "compare_to",
      "compare": ">",
      "inputs": [
        "score",
        "threshold"
      ],
      "outputs": [
        "frame_visible"
      ]
    },
    {
      "type": "draw_text",
      "gltf": "frame_gltf",
      "text": "score",
      "start": "text_start",
      "font_size": "text_font_size",
      "colors": "text_colors",
      "texture_id": "text_texture_id",
      "canvas_width": 1024,
      "canvas_height": 1024,
      "language_and_locale": "en-US",
      "typeface": "sans_serif"
    },
    {
      "type": "render_gltf",
      "gltf": "frame_gltf",
      "pose": "frame_pose",
      "visible": "frame_visible",
      "stereo": false
    }
  ],
  "inputs": [
    "post_det",
    "vst_left_image",
    "vst_right_image",
    "vst_timestamp",
    "vst_camera_matrix"
  ],
  "outputs": [
