  "strings": [
    { "key": "onboarding.speak_title", "en": "What language do you speak?", "zh": "你说哪种语言？" },
    { "key": "onboarding.step_speak", "en": "1 You speak", "zh": "1 你的语言" },
    { "key": "onboarding.step_learn", "en": "2 Learn", "zh": "2 学习" },
    { "key": "onboarding.step_start", "en": "3 Start", "zh": "3 开始" },
    { "key": "onboarding.system_option", "en": "{0} (System)", "zh": "{0}（系统）" },
    { "key": "quiz.end", "en": "End", "zh": "结束" },
    { "key": "tour.welcome", "en": "Welcome to Word World!\nLet me show you around.", "zh": "欢迎来到单词世界！\n我带你看一看。" },
    { "key": "tour.labels", "en": "Words appear above objects in your room.\nTap a glowing word to learn it.", "zh": "房间里的物品上方会出现单词。\n点一下发光的单词来学习。" },
    { "key": "tour.detail", "en": "Here are the meaning and an example.\nClose the card when you are done.", "zh": "这里有意思和例句。\n看完后关掉卡片。" },
    { "key": "tour.status", "en": "This shows the camera is finding objects.\nTap it to pause or resume.", "zh": "这里显示正在识别物品。\n点它可以暂停或继续。" },
    { "key": "tour.home", "en": "Home brings back the menu from anywhere.\nTap it now.", "zh": "主页按钮随时打开菜单。\n现在点一下。" },
    { "key": "tour.journey", "en": "Journey guides you through each level,\nstep by step.", "zh": "学习之旅一步一步\n带你完成每个等级。" },
    { "key": "tour.practice", "en": "Practice has Find It, Say It\nand your Word Bank.", "zh": "练习里有找一找、说一说\n和你的单词本。" },
    { "key": "tour.settings", "en": "Settings has your languages,\nreading level and label size.", "zh": "设置里可以改语言、\n阅读等级和标签大小。" },
    { "key": "tour.replay", "en": "Tap Tour any time to see this again.\nHave fun learning!", "zh": "随时点“教程”可以再看一遍。\n学得开心！" },
    { "key": "tour.next", "en": "Next", "zh": "下一步" },
    { "key": "tour.skip", "en": "Skip tour", "zh": "跳过" },
