#usda 1.0
(
    """ Spatial Component schema    """
    subLayers = [
        @usd/schema.usda@
    ]
)
over "GLOBAL" (
    customData = {
        string libraryName       = "spatialComponent"
        string libraryPath       = "./"
        string libraryPrefix     = "Spatial"
    }
) {
}

class SpatialStruct "SpatialStruct"(
    doc = """ Struct packaging type. Note that it does not specify a typeName """
    inherits = </Typed>
    customData = {
        string className = "UsdStruct"
    }
){
}

# This defines the SpatialComponent schema
class SpatialComponent "SpatialComponent" (
    doc = """ Spatial Component packaging type. Note that it does not specify a typeName"""
    inherits = </Typed>
     customData = {
        string className = "UsdComponent"
     }
)
{
    uniform token info:id (
        doc = "Component Id"
    )
}

# This defines the SpatialCustomComponent schema
class SpatialCustomComponent "SpatialCustomComponent" (
    doc = """Custom Component packaging type. Note that it does not specify a typeName"""
    inherits = </Typed>
     customData = {
        string className = "UsdCustomComponent"
     }
)
{
    uniform token info:id (
        doc = "Component Id"
    )

    uniform token info:version (
        doc = "Component Version"
    )
}